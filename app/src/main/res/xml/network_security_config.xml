<?xml version="1.0" encoding="utf-8"?>
<!-- Many Israeli radio streams are only available over plain HTTP. App data (catalog,
     now-playing endpoints) is always requested over HTTPS in code. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
